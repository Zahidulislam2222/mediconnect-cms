HOST=0.0.0.0
PORT=1337
# Set the same public origin for admin build and runtime when behind HTTPS proxy.
CMS_PUBLIC_URL=
# Enable only with a private/loopback backend and a proxy that replaces forwarded headers.
CMS_TRUST_PROXY=false
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Article migration (explicit plan/execute; use only published editorial content).
# Load this configuration explicitly, e.g. node --env-file=.env scripts/sync-articles.js --plan.
CMS_SYNC_STRAPI_URL=https://cms.example.test
CMS_SYNC_ARTICLES_PATH=/api/articles
CMS_SYNC_STRAPI_TOKEN=
CMS_SYNC_AWS_REGION=us-east-1
CMS_SYNC_DYNAMODB_TABLE=replace-with-knowledge-table
CMS_SYNC_S3_BUCKET=replace-with-media-bucket
CMS_SYNC_MEDIA_PUBLIC_BASE_URL=https://media.example.test/
CMS_SYNC_PUBLIC_ROOT=./public
CMS_SYNC_MEDIA_URL_PREFIX=/uploads/
CMS_SYNC_OBJECT_PREFIX=articles/
CMS_SYNC_PAGE_SIZE=25
CMS_SYNC_MAX_PAGES=100
CMS_SYNC_HTTP_TIMEOUT_MS=30000
CMS_SYNC_MAX_HTTP_BYTES=10485760
CMS_SYNC_MAX_MEDIA_BYTES=10485760
CMS_SYNC_MAX_PLAN_BYTES=52428800
CMS_SYNC_MAX_ARTICLE_BYTES=307200
CMS_SYNC_MAX_ATTEMPTS=2
# Leave endpoints empty for the AWS SDK regional endpoints; HTTP is loopback-only.
CMS_SYNC_S3_ENDPOINT=
CMS_SYNC_DYNAMODB_ENDPOINT=

# Standalone asset migration. --plan never initializes cloud clients.
# Empty prefix preserves original object names; a prefix changes their URLs.
# --execute requires owner approval and may incur storage/request charges.
CMS_ASSET_SOURCE_DIRECTORY=./public/uploads
CMS_ASSET_AWS_REGION=us-east-1
CMS_ASSET_S3_BUCKET=replace-with-asset-bucket
CMS_ASSET_KEY_PREFIX=
CMS_ASSET_MAX_FILES=1000
CMS_ASSET_MAX_FILE_BYTES=10485760
CMS_ASSET_MAX_TOTAL_BYTES=52428800
CMS_ASSET_TIMEOUT_MS=30000
CMS_ASSET_MAX_ATTEMPTS=2
# Empty uses SDK regional endpoints; HTTP is loopback-only for tests.
CMS_ASSET_S3_ENDPOINT=

# CMS runtime: defaults and CSP sources live in src/config/runtime-defaults.json.
DATABASE_FILENAME=.tmp/data.db
FLAG_NPS=true
FLAG_PROMOTE_EE=true
CMS_REST_DEFAULT_LIMIT=25
CMS_REST_MAX_LIMIT=100
CMS_REST_WITH_COUNT=true
AWS_REGION=us-east-1
AWS_BUCKET=replace-with-cms-media-bucket
# Prefer SDK workload roles or the standard credential chain. Never use real values here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Legacy compatibility only; do not configure a different standard and legacy secret.
AWS_ACCESS_SECRET=
CMS_UPLOAD_CONNECTION_TIMEOUT_MS=300000
CMS_UPLOAD_TIMEOUT_MS=300000
CMS_UPLOAD_MAX_ATTEMPTS=3
CMS_UPLOAD_FORCE_PATH_STYLE=false
CMS_UPLOAD_VISIBILITY=public
CMS_UPLOAD_SIGNED_URL_SECONDS=900
# Empty means SDK regional origin / provider-generated object URLs.
CMS_UPLOAD_ENDPOINT=
CMS_UPLOAD_PUBLIC_ORIGIN=
